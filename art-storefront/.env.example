# Copy this file to .env.local and fill in real values.

# Required for the admin dashboard (/admin) — pick your own strong values.
ADMIN_PASSWORD=change-me
SESSION_SECRET=change-me-to-a-long-random-string

# Optional: without this, transactional emails (order receipts, commission
# notifications, notify-me) are just logged to the database instead of sent.
# Get a free key at https://resend.com.
# RESEND_API_KEY=
# RESEND_FROM_EMAIL=studio@yourdomain.com

# Optional: used for canonical URLs in sitemap.xml/robots.txt/Open Graph tags.
# NEXT_PUBLIC_SITE_URL=https://yourdomain.com

# Optional: override where the local SQLite database file lives.
# SQLITE_PATH=./var/app.db
